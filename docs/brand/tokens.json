  "motion": { "ease": "cubic-bezier(0.2, 0.7, 0.1, 1)", "fast": "160ms", "base": "320ms", "slow": "700ms" },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" },
  "zIndex": { "base": 0, "raised": 10, "header": 100, "menu": 200, "gate": 1000 }
