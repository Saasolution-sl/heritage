{
  "name": "heritage-cigars",
  "version": "0.1.0",
  "private": true,
  "description": "Heritage Cigars \u2014 brand system, asset library and catalog website.",
  "scripts": {
    "dev": "next dev",
    "brand": "node scripts/brand/build-assets.mjs",
    "brand:png": "node scripts/brand/export-png.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "node scripts/check-site.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "next": "^16.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "opentype.js": "^1.3.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
